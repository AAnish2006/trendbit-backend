# Database configuration
DATABASE_URL=sqlite:///./trendbit.db

# Supabase Configuration (Provide your Supabase URL & Key to sync with Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Dodo Payments Configuration (From Dodo Payments Dashboard https://app.dodopayments.com)
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key_here
DODO_PRODUCT_ID=pdt_trendbit_rank_bid
DODO_ENVIRONMENT=test_mode
